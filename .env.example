# Flask Application Secret Key
SECRET_KEY=your_secret_key_here

# Supabase PostgreSQL Database URLs (Project oihepjwiogxmpoxsdhti)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only, used for application queries)
DATABASE_URL="postgresql://postgres.oihepjwiogxmpoxsdhti:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations and DDL)
DIRECT_URL="postgresql://postgres.oihepjwiogxmpoxsdhti:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Optional live job API credentials
JSEARCH_API_KEY=your_jsearch_api_key_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Enable SentenceTransformer locally (false by default for lightweight serverless)
ENABLE_HEAVY_TRANSFORMERS=false
